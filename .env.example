# Application configuration (12-factor). Every value can be overridden by env vars
# prefixed SCHED_ (e.g. SCHED_DATABASE_URL / SCHED_MAX_BACKFILL).
# Local docker-compose defaults are baked in so `docker compose up` works out of the box.

SCHED_DATABASE_URL=postgresql://scheduler:scheduler@localhost:5433/scheduler
# Host the HTTP API binds to.
SCHED_HOST=127.0.0.1
SCHED_PORT=8080
# Engine policy knobs (defaults documented in scheduler/config.py).
SCHED_MAX_BACKFILL=100
SCHED_TICK_HORIZON_SECONDS=60
SCHED_PLAN_AHEAD_DAYS=31
SCHED_BACKFILL_WINDOW_DAYS=7
SCHED_DISPATCH_TIMEOUT_SECONDS=5.0
# How often the internal background ticker fires (seconds); API also accepts /ticks?now=
SCHED_TICKER_INTERVAL_SECONDS=1.0
# Set to 0 to disable the in-process ticker entirely (run /ticks from a worker).
SCHED_ENABLE_BACKGROUND_TICKER=1
