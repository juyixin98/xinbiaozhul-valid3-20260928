# 复制为 .env 后按需修改；全部变量均有默认值（见 app/config.py）
DATABASE_URL=postgresql://sched:sched@127.0.0.1:5433/scheduler
SCHEDULER_ENABLED=true
TICK_INTERVAL_SECONDS=15
HORIZON_DAYS=7
LATENESS_GRACE_SECONDS=30
CATCHUP_DEADLINE_SECONDS=3600
CATCHUP_RATE_LIMIT=100
CATCHUP_GLOBAL_BUDGET=1000
LEASE_TIMEOUT_SECONDS=300
MAX_ATTEMPTS=3
MAX_OCCURRENCES_PER_WINDOW=20000
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
