{
  "name": "earley-sppf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Earley recognizer with left-recursion/ambiguity support and a shared packed parse forest (SPPF), with budgeted forest enumeration.",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "verify": "bash scripts/verify.sh",
    "recognize": "tsx src/cli/recognize.ts",
    "compare": "tsx src/cli/compare.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "@types/node": "20.16.13"
  }
}
