# Example local configuration for mqttd.
# This file documents every tunable; the server reads it via -config (simple
# KEY=VALUE format, lines beginning with '#' are comments). All values are
# local-only and require no accounts or external services.

# TCP listen address (plain MQTT 3.1.1, no TLS in this subset).
ADDR=127.0.0.1:1883

# SQLite database file. Durable sessions/subscriptions/inflight/retained
# messages live here. Use an absolute or relative local path.
DB=./data/mqttd.db

# Resource bounds.
MAX_PACKET=262144
MAX_SESSIONS=1024
MAX_SUBS=64
MAX_INFLIGHT=128
MAX_RETAINED=4096
QUEUE=256

# Per-frame kernel write timeout: a client that keeps its TCP receive window
# closed longer than this is disconnected (QoS1 rows survive for replay).
SEND_WRITE_TIMEOUT=30s

# Unacknowledged QoS1 retransmit interval; re-sends carry DUP=1.
RETX=2s
